<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="20260526_002" author="filip">
        <comment>Announcement table for library news / events</comment>

        <createTable tableName="announcement">
            <column name="announcement_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="announcement_pk" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false" notNullConstraintName="announcement_nn01"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false" notNullConstraintName="announcement_nn02"/>
            </column>
            <column name="published_at" type="TIMESTAMP">
                <constraints nullable="false" notNullConstraintName="announcement_nn03"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false" notNullConstraintName="announcement_nn04"
                             foreignKeyName="announcement_fk_author"
                             references="member(member_id)"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>