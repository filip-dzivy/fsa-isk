<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="20260527_002" author="filip">
        <comment>Book description column and book_photo table</comment>

        <addColumn tableName="book">
            <column name="description" type="TEXT"/>
        </addColumn>

        <createTable tableName="book_photo">
            <column name="book_photo_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="book_photo_pk" nullable="false"/>
            </column>
            <column name="book_id" type="BIGINT">
                <constraints nullable="false" notNullConstraintName="book_photo_nn01"
                             foreignKeyName="book_photo_fk_book"
                             references="book(book_id)"/>
            </column>
            <column name="url" type="VARCHAR(1024)">
                <constraints nullable="false" notNullConstraintName="book_photo_nn02"/>
            </column>
            <column name="storage_key" type="VARCHAR(512)">
                <constraints nullable="false" notNullConstraintName="book_photo_nn03"/>
            </column>
            <column name="caption" type="VARCHAR(500)"/>
            <column name="position" type="INT" defaultValueNumeric="0">
                <constraints nullable="false" notNullConstraintName="book_photo_nn04"/>
            </column>
        </createTable>

        <createIndex tableName="book_photo" indexName="book_photo_idx_book">
            <column name="book_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
