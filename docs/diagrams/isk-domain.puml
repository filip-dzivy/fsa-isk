 @startuml isk - doménový model

skinparam class {
    BackgroundColor<<entity>> #FEFECE
    BorderColor<<entity>> #A80036
    BackgroundColor<<valueObject>> #E0F7FA
    BorderColor<<valueObject>> #00ACC1
    BackgroundColor<<enumeration>> #C8E6C9
    BorderColor<<enumeration>> #43A047
    BackgroundColor<<interface>> #E1BEE7
    BorderColor<<interface>> #8E24AA
    BackgroundColor<<factory>> #FFCCBC
    BorderColor<<factory>> #E64A19
    BackgroundColor<<service>> #FFF9C4
    BorderColor<<service>> #F9A825
    BackgroundColor<<event>> #FCE4EC
    BorderColor<<event>> #E91E63
}

package shared {
    abstract class "«abstract»\nDomainEvent" as DomainEvent {
        - occurredOn: Instant
        --
        + getOccurredOn(): Instant
    }
    class "«interface»\nDomainEventPublisher" as DomainEventPublisher <<interface>> {
        + publish(DomainEvent): void
    }
    class "«interface»\nNotificationPort" as NotificationPort <<interface>> {
        + notifyReservationReady(Member, Book): void
        + notifyMembershipExpiringSoon(Member, int daysLeft): void
    }
    class "«interface»\nPhotoStoragePort" as PhotoStoragePort <<interface>> {
        + upload(byte[], String contentType, String key): String
        + delete(String key): void
    }
    class "«exception»\nDomainException" as DomainException {
        - type: Type
        - details: List<String>
        --
        + getType(): Type
        + getDetails(): List<String>
    }
}

package catalog {
    class "«entity»\nBook" as Book <<entity>> {
        - id: Long
        - isbn: ISBN
        - title: String
        - author: String
        - genre: BookGenre
        - publisher: String
        - publicationYear: Year
        - totalCopies: int
        - availableCopies: int
        - description: String
        - photos: List<BookPhoto>
        --
        + {static} MAX_PHOTOS = 5
        + {static} MAX_DESCRIPTION_LENGTH = 2000
        + Book(ISBN, String, String, BookGenre, String, Year, int)
        + isAvailable(): boolean
        + borrowCopy(): void
        + returnCopy(): void
        + addCopies(int): void
        + updateDescription(String): void
        + addPhoto(String url, String key, String caption): BookPhoto
        + removePhoto(long photoId): BookPhoto
        + validateForCreation(): void
    }
    class "«entity»\nBookPhoto" as BookPhoto <<entity>> {
        - id: long
        - url: String
        - storageKey: String
        - caption: String
        - position: int
    }
    class "«value object»\nISBN" as ISBN <<valueObject>> {
        - value: String
        --
        + getValue(): String
        + validate(): boolean
    }
    class "«enumeration»\nBookGenre" as BookGenre <<enumeration>> {
        FICTION, SCIENCE_FICTION
        FANTASY, MYSTERY, THRILLER
        HORROR, ROMANCE
        HISTORICAL_FICTION, ADVENTURE
        NOVEL, BIOGRAPHY, AUTOBIOGRAPHY
        HISTORY, SCIENCE, TECHNOLOGY
        PHILOSOPHY, PSYCHOLOGY, SELF_HELP
        BUSINESS, POLITICS, TRUE_CRIME
        POETRY, DRAMA, CHILDREN
        YOUNG_ADULT, REFERENCE, TRAVEL
        COOKBOOK, ART, RELIGION
        LANGUAGE, OTHER
    }
    class "«interface»\nBookRepository" as BookRepository <<interface>> {
        + find(ISBN): Optional<Book>
        + findAll(): Collection<Book>
        + save(Book): void
        + delete(Book): void
    }
    class "«interface»\nCatalogFacade" as CatalogFacade <<interface>> {
        + create(Book): void
        + find(ISBN): Book
        + findAll(): Collection<Book>
        + delete(ISBN): void
        + addCopies(ISBN, int): void
        + updateDescription(ISBN, String): void
        + addPhoto(ISBN, byte[], String, String, String): BookPhoto
        + removePhoto(ISBN, long photoId): void
    }
    class "«service»\nCatalogService" as CatalogService <<service>> {
        - bookRepository: BookRepository
        - photoStoragePort: PhotoStoragePort
        --
        + CatalogService(BookRepository, PhotoStoragePort)
    }
    Book "1" *-- "1" ISBN : -isbn
    Book "1" -- "1" BookGenre : -genre
    Book "1" *-- "*" BookPhoto : -photos
    BookRepository ..> Book
    CatalogService ..|> CatalogFacade
    CatalogService ..> BookRepository : uses
    CatalogService ..> PhotoStoragePort : uses
}

package announcement {
    class "«entity»\nAnnouncement" as Announcement <<entity>> {
        - id: long
        - title: String
        - content: String
        - publishedAt: LocalDateTime
        - author: Member
        - photos: List<AnnouncementPhoto>
        --
        + {static} MAX_PHOTOS = 5
        + Announcement(String, String, Member)
        + update(String, String): void
        + addPhoto(String url, String key, String caption): AnnouncementPhoto
        + removePhoto(long photoId): AnnouncementPhoto
        + validateForCreation(): void
    }
    class "«entity»\nAnnouncementPhoto" as AnnouncementPhoto <<entity>> {
        - id: long
        - url: String
        - storageKey: String
        - caption: String
        - position: int
    }
    class "«interface»\nAnnouncementRepository" as AnnouncementRepository <<interface>> {
        + find(long id): Optional<Announcement>
        + findAll(): List<Announcement>
        + save(Announcement): void
        + delete(long id): void
    }
    class "«interface»\nAnnouncementFacade" as AnnouncementFacade <<interface>> {
        + create(String title, String content, Member author): Announcement
        + update(long id, String title, String content): Announcement
        + find(long id): Announcement
        + findAll(): List<Announcement>
        + delete(long id): void
        + addPhoto(long, byte[], String, String, String): AnnouncementPhoto
        + removePhoto(long announcementId, long photoId): void
    }
    class "«service»\nAnnouncementService" as AnnouncementService <<service>> {
        - announcementRepository: AnnouncementRepository
        - photoStoragePort: PhotoStoragePort
        --
        + AnnouncementService(AnnouncementRepository, PhotoStoragePort)
    }
    Announcement "1" *-- "*" AnnouncementPhoto : -photos
    AnnouncementRepository ..> Announcement
    AnnouncementService ..|> AnnouncementFacade
    AnnouncementService ..> AnnouncementRepository : uses
    AnnouncementService ..> PhotoStoragePort : uses
}

package member {
    class "«entity»\nMember" as MemberE <<entity>> {
        - id: long
        - email: Email
        - firstName: String
        - lastName: String
        - memberRole: MemberRole
        - membership: Membership
        - fines: List<Fine>
        --
        + Member(long, Email, String, String, MemberRole)
        + canBorrow(): boolean
        + hasUnpaidFines(): boolean
        + addFine(Fine): void
        + assignMembership(Membership): void
        + renewMembership(): void
        + validateForCreation(): void
        + getFullName(): String
    }
    class "«value object»\nEmail" as Email <<valueObject>> {
        - value: String
        --
        + toString(): String
    }
    class "«value object»\nMembership" as MembershipVO <<valueObject>> {
        - expiryDate: LocalDate
        - status: MembershipStatus
        --
        + {static} createNew(): Membership
        + isActive(): boolean
        + isExpiringSoon(): boolean
        + renew(): Membership
        + getExpiryDate(): LocalDate
        + getStatus(): MembershipStatus
    }
    class "«enumeration»\nMemberRole" as MemberRole <<enumeration>> {
        MEMBER
        LIBRARIAN
        ADMIN
    }
    class "«enumeration»\nMembershipStatus" as MembershipStatus <<enumeration>> {
        ACTIVE
        EXPIRED
        SUSPENDED
    }
    class "«interface»\nMemberRepository" as MemberRepository <<interface>> {
        + find(long id): Optional<Member>
        + find(Email): Optional<Member>
        + findWithFines(long id): Optional<Member>
        + findAllWithFines(): Collection<Member>
        + save(Member): void
        + delete(long id): void
    }
    class "«interface»\nMemberFacade" as MemberFacade <<interface>> {
        + create(Member): void
        + find(long id): Member
        + find(Email): Member
        + findAll(): Collection<Member>
        + findOrProvision(Email, String, String): Member
        + renewMembership(long id): void
        + payFine(long memberId, long fineId): void
        + waiveFine(long memberId, long fineId): void
    }
    class "«service»\nMemberService" as MemberService <<service>> {
        - memberRepository: MemberRepository
        --
        + MemberService(MemberRepository)
    }
    MemberE "1" *-- "1" Email : -email
    MemberE "1" *-- "1" MembershipVO : -membership
    MemberE "1" -- "1" MemberRole : -memberRole
    MembershipVO "1" -- "1" MembershipStatus : -status
    MemberRepository ..> MemberE
    MemberService ..|> MemberFacade
    MemberService ..> MemberRepository : uses
}

package finance {
    class "«entity»\nFine" as Fine <<entity>> {
        - id: long
        - amount: Money
        - reason: String
        - status: FineStatus
        - loan: Loan
        - member: Member
        --
        + Fine(Money, String)
        + Fine(Money, String, Loan)
        + pay(): void
        + waive(): void
        + updateAmount(Money): void
        + isPaid(): boolean
    }
    class "«value object»\nMoney" as Money <<valueObject>> {
        - amount: BigDecimal
        - currency: String
        --
        + {static} of(double, String): Money
        + {static} zero(String): Money
        + add(Money): Money
        + multiply(long): Money
        + isGreaterThanZero(): boolean
    }
    class "«enumeration»\nFineStatus" as FineStatus <<enumeration>> {
        PENDING
        PAID
        WAIVED
    }
    class "«interface»\nFineRepository" as FineRepository <<interface>> {
        + findPendingByLoan(Loan): Optional<Fine>
        + save(Fine): void
    }
    class "«factory»\nFineFactory" as FineFactory <<factory>> {
        + createFor(Loan, Money): Fine
        + updateFor(Fine, Loan, Money): void
    }
    class "«service»\nFineService" as FineService <<service>> {
        + calculate(Loan): Fine
        + dailyRate(): Money
    }
    Fine "1" *-- "1" Money : -amount
    Fine "1" -- "1" FineStatus : -status
    FineRepository ..> Fine
    FineFactory ..> Fine : creates
    FineService ..> Fine : creates
}

package lending {
    class "«entity»\nLoan" as Loan <<entity>> {
        - id: long
        - loanedTo: Member
        - book: Book
        - createdBy: Member
        - loanDate: LocalDate
        - dueDate: LocalDate
        - returnDate: LocalDate
        - renewalCount: int
        - status: LoanStatus
        --
        + Loan(Member, Book, Member)
        + Loan(Member, Book, Member, LocalDate, int)
        + validateForCreation(): void
        + returnBook(): void
        + renew(Member requestedBy): void
        + markOverdue(): void
        + isOverdue(): boolean
        + daysOverdue(): long
    }
    class "«enumeration»\nLoanStatus" as LoanStatus <<enumeration>> {
        ACTIVE
        RETURNED
        OVERDUE
    }
    class "«interface»\nLoanRepository" as LoanRepository <<interface>> {
        + find(long id): Optional<Loan>
        + findByMember(Member): Collection<Loan>
        + findByBook(Book): Collection<Loan>
        + findAll(): Collection<Loan>
        + findOverdueLoans(): Collection<Loan>
        + save(Loan): void
    }
    class "«factory»\nLoanFactory" as LoanFactory <<factory>> {
        + createLoan(Member, Book, Member): Loan
        + createLoan(Member, Book, Member, LocalDate, int): Loan
    }
    class "«event»\nBookReturnedEvent" as BookReturnedEvent <<event>> {
        - book: Book
    }
    class "«interface»\nLoanFacade" as LoanFacade <<interface>> {
        + create(Member, Book, Member): void
        + find(long id): Loan
        + findAll(): List<Loan>
        + findByMember(Member): List<Loan>
        + findOverdue(): List<Loan>
        + renew(Loan, Member): void
        + returnBook(Loan): void
    }
    class "«service»\nLoanService" as LoanService <<service>> {
        - bookRepository, memberRepository, loanRepository
        - loanFactory, fineRepository, fineFactory
        - eventPublisher, finesDailyRate: Money
    }
    Loan "1" -- "1" LoanStatus : -status
    LoanRepository ..> Loan
    LoanFactory ..> Loan : creates
    BookReturnedEvent --|> DomainEvent
    LoanService ..|> LoanFacade
    LoanService ..> LoanRepository : uses
    LoanService ..> LoanFactory : uses
    LoanService ..> FineFactory : uses
    LoanService ..> FineRepository : uses
    LoanService ..> DomainEventPublisher : uses
    LoanService ..> BookReturnedEvent : publishes
}

package reservation {
    class "«entity»\nReservation" as Reservation <<entity>> {
        - id: long
        - createdBy: Member
        - book: Book
        - createdOn: LocalDate
        - status: ReservationStatus
        - positionInQueue: int
        --
        + Reservation(Member, Book)
        + validateForCreation(): void
        + activate(): void
        + cancel(Member requestedBy): void
        + expire(): void
        + fulfill(): void
        + isExpiredByDate(): boolean
        + isActive(): boolean
    }
    class "«enumeration»\nReservationStatus" as ReservationStatus <<enumeration>> {
        PENDING
        READY_FOR_PICKUP
        FULFILLED
        CANCELLED
        EXPIRED
    }
    class "«interface»\nReservationRepository" as ReservationRepository <<interface>> {
        + find(long id): Optional<Reservation>
        + findByMember(Member): Collection<Reservation>
        + findByBook(Book): Collection<Reservation>
        + findActiveByBook(Book): Collection<Reservation>
        + findAll(): Collection<Reservation>
        + save(Reservation): void
    }
    class "«interface»\nReservationFacade" as ReservationFacade <<interface>> {
        + create(Member, Book): void
        + cancel(Reservation, Member): void
        + notifyNextInQueue(Book): void
        + expireReadyReservations(): void
        + hasPendingReservation(Book): boolean
        + find(long id): Reservation
        + findAll(): List<Reservation>
        + findByMember(Member): List<Reservation>
        + findByBook(Book): List<Reservation>
    }
    class "«service»\nReservationService" as ReservationService <<service>> {
        - reservationRepository: ReservationRepository
        - notificationPort: NotificationPort
    }
    Reservation "1" -- "1" ReservationStatus : -status
    ReservationRepository ..> Reservation
    ReservationService ..|> ReservationFacade
    ReservationService ..> ReservationRepository : uses
    ReservationService ..> NotificationPort : uses
}

' ── Cross-package relácie ──
MemberE "1" o-- "*" Fine : -fines
Fine "*" --> "1" Loan : -loan
Fine "*" --> "1" MemberE : -member

Loan "*" --> "1" MemberE : -loanedTo
Loan "*" --> "1" Book : -book
Loan "*" --> "1" MemberE : -createdBy

Reservation "*" --> "1" MemberE : -createdBy
Reservation "*" --> "1" Book : -book

Announcement "*" --> "1" MemberE : -author

@enduml